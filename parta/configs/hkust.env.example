# Public settings only; key comes from AIAA3102_API_KEY in the process environment.
# This is HKUST HPC AIGC, not Diandong Cloud.
ZZZ_BASE_URL=https://aigc-api.hkust-gz.edu.cn/api/v2
ZZZ_MODEL=DeepSeek-V4.1-Flash
PARTC_DISABLE_THINKING=true
PARTC_MAX_RETRIES=0
PARTC_TIMEOUT_SECONDS=60
# School intranet endpoint: bypass inherited proxy settings for this client only.
# TLS certificate verification stays enabled; system proxy settings are unchanged.
PARTC_TRUST_ENV=false
