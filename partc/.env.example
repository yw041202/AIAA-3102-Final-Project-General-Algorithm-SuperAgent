# ---------------------------------------------------------------------------
# Part C toolkit — environment template.
# Copy this file to ".env" and fill in ZZZ_API_KEY.  NEVER commit ".env".
# ---------------------------------------------------------------------------

# Zhizengzeng (智增增) unified API gateway.
# Base URL must end with a single "/v1" (the SDK appends "/chat/completions").
ZZZ_API_KEY=
ZZZ_BASE_URL=https://api.zhizengzeng.com/v1

# Requested model id, as accepted by Zhizengzeng.  It must map to a compliant
# entry in configs/model_registry.json (Qwen or DeepSeek, released on or
# before 2026-10-21, with official standard pricing).
ZZZ_MODEL=deepseek-v4.1-flash-1017

# Course budget per evaluation task, in RMB.
PARTC_BUDGET_RMB=20

# Runtime directories (relative to the working directory, or absolute).
PARTC_LOG_DIR=./logs
PARTC_STATE_DIR=./.partc_state

# LLM request behaviour.
PARTC_TIMEOUT_SECONDS=120
PARTC_MAX_RETRIES=3